# Copy to .env.local. NEXT_PUBLIC_* values are compiled into the build: set them before `npm run build`.

# IIAE CRM API (Node.js). The website's forms post here from the browser, and the blog /
# newsroom pages read their posts from it on the server (GET /api/posts/...).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api
# The student login and dashboard use it too. In the API's .env, set FRONTEND_URL to this
# site's origin (PayU return pages and email links point there).

# Optional: lets the CRM API refresh blog / newsroom pages the moment a post is saved
# (POST /api/revalidate). Use a long random value and set the same one as
# WEBSITE_REVALIDATE_SECRET in the API's .env. Without it, pages refresh within a minute anyway.
REVALIDATE_SECRET=

# Optional
# NEXT_PUBLIC_SITE_URL=https://iiae.in
# NEXT_PUBLIC_GTM_ID=GTM-KZC9FMMV
